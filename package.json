{
  "name": "rideit-clone-backend",
  "version": "1.0.0",
  "description": "Ride-hailing app backend server like Rapido",
  "author": "Ride-Hailing Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=8000' nest build",
    "format": "prettier --ignore-path .prettierignore --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --ignore-path .prettierignore --check \"**/*.{ts,js,json,md}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_OPTIONS='--require dd-trace/init' node dist/src/main",
    "lint:check": "eslint \"**/*.ts\" --fix --ignore-pattern 'dist/**'",
    "type:check": "tsc --pretty --noEmit",
    "lint:fix": "eslint \"**/*.ts\" --fix --ignore-pattern 'dist/**'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --config jest.config.ts --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --clearCache && NODE_OPTIONS='--max-old-space-size=8000' jest --config jest.config.ts --detectOpenHandles --forceExit --logHeapUsage --runInBand",
    "migrate:drivers-to-users": "ts-node -r tsconfig-paths/register src/migrations/migrate-drivers-to-users.ts",
    "migrate:drivers-to-users:live": "DRY_RUN=false ts-node -r tsconfig-paths/register src/migrations/migrate-drivers-to-users.ts",
    "rollback:drivers-migration": "ts-node -r tsconfig-paths/register src/migrations/rollback-drivers-migration.ts",
    "rollback:drivers-migration:live": "DRY_RUN=false ts-node -r tsconfig-paths/register src/migrations/rollback-drivers-migration.ts"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.20",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^10.4.20",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "geolib": "^3.3.4",
    "ioredis": "^5.7.0",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.17.1",
    "nestjs-pino": "^4.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino-pretty": "^13.0.0",
    "razorpay": "^2.9.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-perfectionist": "^5.2.0",
    "eslint-plugin-prettier": "^5.2.2",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.3.4",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.7.3"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  }
}
