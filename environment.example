# ===========================================
# RAPIDO CLONE BACKEND - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ===========================================

# App Configuration
NODE_ENV=development
PORT=3010
APP_NAME="Rapido Clone"
APP_VERSION=1.0.0

# ===========================================
# JWT Authentication
# ===========================================
# IMPORTANT: Generate strong secrets for production
# Use: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=365d

# ===========================================
# MongoDB Database
# ===========================================
MONGODB_URI=mongodb://admin:password@localhost:27017/rapido_db?authSource=admin

# ===========================================
# Redis Cache & Real-time State
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=rideit:

# ===========================================
# Kafka Message Broker
# ===========================================
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=rideit-app
KAFKA_GROUP_ID=rideit-consumer-group

# ===========================================
# Razorpay Payment Gateway
# ===========================================
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ===========================================
# SMS Provider (for OTP)
# ===========================================
# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Or MSG91 (https://msg91.com)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=RAPIDO
MSG91_TEMPLATE_ID=your_template_id

# ===========================================
# Push Notifications (Firebase)
# ===========================================
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ===========================================
# Google Maps API (for distance/ETA)
# ===========================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ===========================================
# Rate Limiting
# ===========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ===========================================
# Location & Booking Settings
# ===========================================
DEFAULT_SEARCH_RADIUS=5000
MAX_SEARCH_RADIUS=20000
DRIVER_LOCATION_TTL=300
DEFAULT_WAIT_TIME=300
MAX_WAIT_TIME=900
AUTO_ACCEPT_TIME=60

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

