# Environment Configuration for hanumanji2 Backend

# Application
NODE_ENV=development
PORT=3010
API_PREFIX=api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ridet-dev
MONGODB_MAX_POOL_SIZE=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Kafka (Optional - for production)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ridet-backend
KAFKA_GROUP_ID=ridet-group

# SMS Provider (for OTP - configure in production)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Google Maps (for geocoding - optional)
GOOGLE_MAPS_API_KEY=AIzaSyCoHyuEddyibszAk_7tuK3R734OqzVhIt4

# File Upload (S3 or local)
STORAGE_TYPE=local
AWS_S3_BUCKET=ridet-documents
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Service Area (Pari Chowk, Greater Noida)
SERVICE_AREA_LAT=28.4744
SERVICE_AREA_LNG=77.4920
SERVICE_AREA_RADIUS_KM=5

# Phase Configuration (for fare calculation)
CURRENT_PHASE=PHASE_1
